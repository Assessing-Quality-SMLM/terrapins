<assembly xmlns="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.3"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.3
                              http://maven.apache.org/xsd/assembly-1.1.3.xsd">
  <!--
    Replaces the stock jar-with-dependencies descriptor for one reason: that one lets a
    dependency's plugins.config overwrite ours.

    ImageJ reads a single plugins.config from the root of each jar to build its menus. Both this
    plugin and the bundled fast fitter ship one, they land at the same path, and whichever the
    assembly unpacks last wins. It was the fitter's - so the built jar advertised the Fast SMLM
    entries and none of TERRAPINS' own, and the Workflow, Results Viewer and HAWK Stream commands
    simply did not appear. Silently, since a menu that is absent raises nothing.

    So dependencies are unpacked with plugins.config excluded, and this module's own copy is the
    only one in the jar. It carries the fitter's entries too - see src/main/resources.

    Anything else added to the bundle that ships a root-level plugins.config needs the same
    treatment, and is worth checking for: the failure is invisible until someone looks for a menu.
  -->
  <id>jar-with-dependencies</id>
  <formats>
    <format>jar</format>
  </formats>
  <includeBaseDirectory>false</includeBaseDirectory>
  <dependencySets>
    <dependencySet>
      <outputDirectory>/</outputDirectory>
      <useProjectArtifact>true</useProjectArtifact>
      <unpack>true</unpack>
      <scope>runtime</scope>
      <unpackOptions>
        <excludes>
          <exclude>plugins.config</exclude>
        </excludes>
      </unpackOptions>
    </dependencySet>
  </dependencySets>
  <fileSets>
    <!-- Our own plugins.config, added after the dependencies so nothing can shadow it. -->
    <fileSet>
      <directory>${project.basedir}/src/main/resources</directory>
      <outputDirectory>/</outputDirectory>
      <includes>
        <include>plugins.config</include>
      </includes>
    </fileSet>
  </fileSets>
</assembly>
